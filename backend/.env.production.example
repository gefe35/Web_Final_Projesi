# Production ortamı — .env olarak kopyala ve doldur
DEBUG=False
SECRET_KEY=BURAYA_EN_AZ_50_KARAKTER_RASTGELE_KEY_YAZ

# Subdomain
ALLOWED_HOSTS=gefeblog.twinshareapp.com,www.gefeblog.twinshareapp.com

# Frontend URL artık aynı domain olduğu için CORS gerekmez
# Ama farklı port/domain test ederken açabilirsin:
# CORS_ALLOWED_ORIGINS=https://gefeblog.twinshareapp.com

# SQLite (basit, blog için yeterli)
# DATABASE_URL satırını yorum yap → otomatik SQLite kullanılır

# PostgreSQL istersen (docker-compose çalışıyorsa):
# DATABASE_URL=postgres://bloguser:blogpassword@127.0.0.1:5433/blogdb
